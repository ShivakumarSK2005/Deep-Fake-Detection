   "source": [
    "# 🎬🔊 Multimodal Deepfake Detection (Video + Audio)
",
    "
",
    "This notebook builds a dual-branch deep learning model for deepfake detection using:
",
    "- Video frames (24 frames, 128×128)
",
    "- Audio MFCCs (128×128)
",
    "
",
    "Handles cases when:
",
    "- Video has no audio
",
    "- Audio-only uploaded
",
    "- Video-only uploaded
",
    "- Both audio & video
"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🛠️ Install dependencies (Colab only)
",
    "!pip install -q moviepy librosa"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 📦 Imports
",
    "import os
",
    "import numpy as np
",
    "import librosa
",
    "import cv2
",
    "from moviepy.editor import VideoFileClip
",
    "from keras.models import Model
",
    "from keras.layers import Input, Conv2D, MaxPooling2D, Flatten, Dense, Dropout, concatenate
",
    "from keras.utils import to_categorical
",
    "from sklearn.model_selection import train_test_split
"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🎥 Extract 24 video frames resized to 128×128
",
    "def extract_video_frames(video_path, target_frames=24, size=(128, 128)):
",
    "    clip = VideoFileClip(video_path)
",
    "    duration = clip.duration
",
    "    frame_times = np.linspace(0, duration, num=target_frames)
",
    "    frames = []
",
    "    for t in frame_times:
",
    "        try:
",
    "            frame = clip.get_frame(t)
",
    "            frame = cv2.resize(frame, size)
",
    "            frames.append(frame)
",
    "        except:
",
    "            frames.append(np.zeros((*size, 3), dtype=np.uint8))
",
    "    return np.array(frames)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🎵 Extract 128x128 MFCCs
",
    "def extract_audio_mfcc(audio_path, size=(128, 128)):
",
    "    try:
",
    "        y, sr = librosa.load(audio_path)
",
    "        mfcc = librosa.feature.mfcc(y=y, sr=sr, n_mfcc=40)
",
    "        mfcc = cv2.resize(mfcc, size)
",
    "        return mfcc[..., np.newaxis]
",
    "    except:
",
    "        return np.zeros((*size, 1))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🧠 Dual Branch CNN Model
",
    "def build_model():
",
    "    # Video branch
",
    "    video_input = Input(shape=(24, 128, 128, 3), name='video_input')
",
    "    v = Conv2D(16, (3, 3), activation='relu')(video_input[:, 0])  # just frame 0 for demo
",
    "    v = MaxPooling2D()(v)
",
    "    v = Flatten()(v)
",
    "    video_output = Dense(2, activation='softmax', name='video_output')(v)
",
    "
",
    "    # Audio branch
",
    "    audio_input = Input(shape=(128, 128, 1), name='audio_input')
",
    "    a = Conv2D(16, (3, 3), activation='relu')(audio_input)
",
    "    a = MaxPooling2D()(a)
",
    "    a = Flatten()(a)
",
    "    audio_output = Dense(2, activation='softmax', name='audio_output')(a)
",
    "
",
    "    model = Model(inputs=[video_input, audio_input], outputs=[video_output, audio_output])
",
    "    model.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['accuracy'])
",
    "    return model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🧪 Dummy Data Training (optional)
",
    "X_v = np.random.rand(10, 24, 128, 128, 3)
",
    "X_a = np.random.rand(10, 128, 128, 1)
",
    "y = to_categorical(np.random.randint(0, 2, 10), num_classes=2)
",
    "
",
    "model = build_model()
",
    "model.fit([X_v, X_a], [y, y], epochs=2, validation_split=0.2)
",
    "model.save("multimodal_model.keras")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🔍 Prediction Function
",
    "def predict_multimodal(video_path, model_path):
",
    "    model = build_model()
",
    "    model.load_weights(model_path)
",
    "
",
    "    # Try extracting video
",
    "    try:
",
    "        video_frames = extract_video_frames(video_path)
",
    "        video_frames = video_frames[np.newaxis, ...]
",
    "    except:
",
    "        video_frames = np.zeros((1, 24, 128, 128, 3))
",
    "
",
    "    # Try extracting audio from video
",
    "    try:
",
    "        audio_path = 'temp.wav'
",
    "        clip = VideoFileClip(video_path)
",
    "        clip.audio.write_audiofile(audio_path, verbose=False, logger=None)
",
    "        mfcc = extract_audio_mfcc(audio_path)
",
    "        os.remove(audio_path)
",
    "    except:
",
    "        mfcc = np.zeros((128, 128, 1))
",
    "
",
    "    mfcc = mfcc[np.newaxis, ...]
",
    "    v_pred, a_pred = model.predict([video_frames, mfcc])
",
    "    print("🎬 Video prediction:", v_pred[0], "→ fake confidence:", v_pred[0][0])
",
    "    print("🎵 Audio prediction:", a_pred[0], "→ fake confidence:", a_pred[0][0])"
   ]
  }
 ],
